+    function W:HasLearnedRoute()
+        local r =
+            root()
+
+        local round =
+            D.gameRound()
+
+        if not r
+            or not round
+            or hasObjective()
+        then
+            return false,
+                "UNAVAILABLE"
+        end
+
+        local key =
+            routeKey(round)
+
+        local learned =
+            Learn[key]
+
+        if type(learned)
+            ~= "table"
+        then
+            return false,
+                "NO_LEARNED_ROUTE"
+        end
+
+        local source =
+            tableV3(
+                learned.source
+            )
+
+        local target =
+            tableV3(
+                learned.target
+            )
+
+        if not source
+            or not target
+        then
+            return false,
+                "INVALID_LEARNED_ROUTE"
+        end
+
+        local sourceDist =
+            (
+                r.Position
+                - source
+            ).Magnitude
+
+        local sourceLimit =
+            learned.kind == "PORTAL"
+            and 420
+            or 120
+
+        if sourceDist > sourceLimit then
+            return false,
+                "SOURCE_TOO_FAR",
+                learned.kind,
+                sourceDist
+        end
+
+        return true,
+            key,
+            learned.kind
+                or "LEARNED",
+            sourceDist
+    end
