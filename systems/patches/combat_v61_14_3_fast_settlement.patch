+-- Fast 24/7 maintenance exit. IMPORTANT: this section deliberately creates
+-- ZERO new top-level locals because combat.lua is already at Luau's local
+-- register ceiling. Scratch values live briefly in getgenv() instead.
+getgenv().IronSoulFastSettlementScratch =
+    {
+        dungeonBagFullStatus()
+    }
+
+getgenv().IronSoulFastSettlementScratch.Inventory =
+    inventoryCountNow()
+
+if getgenv().IronSoulFastSettlementScratch[1]
+    or getgenv().IronSoulFastSettlementScratch.Inventory
+        >= INVENTORY_CLEAN_AT
+then
+    important(
+        "Maintenance | immediate Lobby | "
+            .. tostring(
+                getgenv().IronSoulFastSettlementScratch[1]
+                and getgenv().IronSoulFastSettlementScratch[2]
+                or "INVENTORY_HIGH"
+            )
+    )
+
+    writeJournal({
+        State = "FAST_MAINTENANCE",
+        Decision = "LOBBY_MAINTENANCE",
+        World = journal.World or "?",
+        Diff = journal.Diff or "?",
+        DirectRepeats = 0,
+        FailureCount = journal.FailureCount or 0,
+        UpdatedAt = os.time(),
+    })
+
+    directLobby(
+        getgenv().IronSoulFastSettlementScratch[1]
+        and (
+            "BAG_FULL_"
+            .. tostring(
+                getgenv().IronSoulFastSettlementScratch[2]
+            )
+        )
+        or "INVENTORY_HIGH"
+    )
+
+    getgenv().IronSoulFastSettlementScratch = nil
+    return
+end
+
+getgenv().IronSoulFastSettlementScratch = nil
