+-- Drain policy for long-running farming:
+-- preserve premium ores instead of spending the best 70 just to empty the bag.
+-- Upgrade attempts use buildBestOreMap(); routine capacity drain uses this.
+local function buildWorstOreMap(
+    amountNeeded
+)
+    local _, _, ores =
+        oreTotalAndMax()
+
+    local rows = {}
+
+    for id, amount in pairs(ores) do
+        amount =
+            math.floor(
+                num(amount)
+            )
+
+        if amount > 0 then
+            table.insert(
+                rows,
+                {
+                    ID = id,
+                    Amount = amount,
+                    Score =
+                        oreQuality(id),
+                }
+            )
+        end
+    end
+
+    table.sort(
+        rows,
+        function(a,b)
+            if a.Score
+                ~= b.Score
+            then
+                return a.Score
+                    < b.Score
+            end
+
+            return a.Amount
+                > b.Amount
+        end
+    )
+
+    local map = {}
+    local used = 0
+    local lowest = nil
+
+    for _, row in ipairs(rows) do
+        if used
+            >= amountNeeded
+        then
+            break
+        end
+
+        local take =
+            math.min(
+                row.Amount,
+                amountNeeded
+                    - used
+            )
+
+        if take > 0 then
+            map[row.ID] = take
+            used += take
+
+            if not lowest then
+                lowest =
+                    row.ID
+            end
+        end
+    end
+
+    return map,
+        used,
+        lowest
+end
